rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de Usuarios: Registro, datos vecinales y tokens FCM
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if request.auth != null || userId.matches('vecino_.*');
    }

    // Colección de Reportes de Seguridad y Botón de Pánico
    match /reportes/{reporteId} {
      // Cualquier vecino o ciudadano puede visualizar incidentes comunitarios en el mapa
      allow read: if true;

      // Creación de alertas vecinales o emergencias SOS
      allow create: if true;

      // Validación comunitaria (incremento de contador_validaciones) y actualización de estado
      allow update: if true;

      // Eliminación reservada para autores o administradores
      allow delete: if request.auth != null;
    }

    // Colección de Auditoría de Validaciones Comunitarias
    match /auditoria_validaciones/{docId} {
      allow read, write: if true;
    }
  }
}
